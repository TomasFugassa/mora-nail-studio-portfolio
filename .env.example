# Desarrollo: demostración sin citas reales. Cambiar a false solo tras acordar horarios.
BERE_DEMO_MODE=true
# Obligatoria antes del primer inicio en producción (12 a 128 caracteres).
# En desarrollo, sin esta variable se genera .local-admin-access.txt, ignorado por Git.
# BERE_ADMIN_PASSWORD=
# Carpeta privada persistente; nunca dentro de public/ o dist/client/.
BERE_DATA_DIR=.bere-data
# En producción, origen HTTPS exacto, sin barra final.
# BERE_SITE_ORIGIN=https://dominio-del-estudio
# PORT=4321
# HOST=127.0.0.1
