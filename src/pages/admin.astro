---
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '../styles/admin.css';
import '../styles/admin-mora.css';
import { getView } from '../lib/view';
const view=await getView();
const photoMap=Object.fromEntries(view.photos.map(photo=>[photo.image,photo.thumbnail]));
const sections=[['home','Inicio','home'],['agenda','Agenda','calendar'],['clients','Clientes','users'],['photos','Galería','image'],['services','Servicios','spark'],['hours','Horarios','clock'],['content','Tu página','layout'],['location','Ubicación','pin'],['access','Acceso','lock']];
---
<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="robots" content="noindex,nofollow,noarchive"/><meta name="theme-color" content="#472631"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-title" content="Mi Mora"/>
    <link rel="manifest" href="/admin.webmanifest" crossorigin="use-credentials"/><link rel="apple-touch-icon" href="/pwa/mora-192.png"/><link rel="icon" href="/favicon.svg"/>
    <title>Mi Mora · Panel del estudio</title>
  </head>
  <body class="admin-page" data-mora-panel="atelier-1">
    <a href="#admin-editor" class="admin-skip">Saltar al contenido</a>
    <main id="admin-login" class="login-layout" aria-labelledby="login-title">
      <div class="login-story">
        <img class="login-photo" src={view.hero.large} alt="" width="1024" height="1280" fetchpriority="high"/>
        <a class="admin-logo" href="/" aria-label="Mora, volver a la página">mora<span>NAIL STUDIO</span></a>
        <div class="login-story-copy"><p class="eyebrow">MI MORA</p><h1>Todo tu estudio,<br/>en un solo lugar</h1><p>La agenda, la colección y los pequeños detalles que hacen tu página.</p></div>
        <small>DE LA COLECCIÓN <span>{view.hero.title}</span></small>
      </div>
      <div class="login-side"><div class="login-card">
        <a class="login-wordmark" href="/" aria-label="Mora, volver a la página">mora</a>
        <p class="eyebrow">ACCESO AL ESTUDIO</p><h2 id="login-title">Entrá a<br/><em>Mi Mora</em></h2>
        <p>Un espacio para organizar tu trabajo y cuidar tu página.</p>
        <form id="login-form"><label for="admin-password">Contraseña</label><div class="password-wrap"><input id="admin-password" type="password" required autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="128"/><button id="show-password" type="button" aria-label="Mostrar contraseña">Ver</button></div><button type="submit" class="primary">Entrar al estudio <span aria-hidden="true">↗</span></button><p id="login-error" role="alert"></p></form>
        <div class="login-links"><a href="/" class="quiet-link">Volver a la página</a><button type="button" class="text-button install-trigger">Instalar Mi Mora</button></div>
      </div></div>
    </main>
    <div id="admin-workspace" class="app-layout" hidden>
      <aside class="sidebar">
        <a href="/" class="admin-logo" aria-label="Mora, volver a la página">mora<span>NAIL STUDIO</span></a>
        <p class="nav-caption">MI ESTUDIO</p>
        <nav id="admin-tabs" aria-label="Secciones del panel">{sections.map(([id,label,ico])=><button type="button" data-tab={id} data-icon={ico}><span>{label}</span></button>)}</nav>
        <div class="sidebar-bottom"><button class="install-trigger install-card" type="button"><span class="install-symbol" aria-hidden="true">m</span><span>Mi Mora, a mano<small>Instalar el panel</small></span><span aria-hidden="true">↗</span></button><a href="/" target="_blank" rel="noopener noreferrer" class="sidebar-preview">Ver mi página <span aria-hidden="true">↗</span></a></div>
      </aside>
      <div class="app-main">
        <header class="app-topbar"><a class="mobile-brand" href="/" aria-label="Mora, volver a la página">mora<span id="mobile-section-label">MI ESTUDIO</span></a><p id="panel-breadcrumb">Mi Mora <span aria-hidden="true">/</span> <strong>Inicio</strong></p><div class="topbar-actions"><a class="topbar-preview" href="/" target="_blank" rel="noopener noreferrer" aria-label="Ver mi página en otra pestaña">Ver página <span aria-hidden="true">↗</span></a><button class="avatar-button" id="logout" type="button" aria-label="Cerrar sesión">Salir <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H4v14h5M14 8l4 4-4 4M9 12h10"/></svg></button></div></header>
        <main class="workspace-content"><p id="offline-notice" class="admin-demo" role="status" hidden>Sin conexión. Volvé a conectarte para guardar cambios y consultar la agenda actualizada.</p><section id="admin-editor" tabindex="-1" aria-label="Contenido del panel"></section></main>
      </div>
      <nav class="mobile-dock" aria-label="Accesos rápidos"><button type="button" data-route="home" data-icon="home">Inicio</button><button type="button" data-route="agenda" data-icon="calendar">Agenda</button><button type="button" data-route="photos" data-icon="image">Galería</button><button type="button" id="more-nav" data-icon="menu">Más</button></nav>
    </div>
    <dialog id="editor-dialog" class="editor-dialog" aria-labelledby="dialog-heading"><div class="dialog-header"><div><p class="eyebrow" id="dialog-eyebrow">MI MORA</p><h2 id="dialog-heading"></h2></div><button id="close-editor" type="button" class="icon-button" aria-label="Cerrar ventana">×</button></div><div id="dialog-body"></div></dialog>
    <div id="admin-status" role="status" aria-live="polite" class="toast" hidden></div>
    <script id="admin-photo-map" type="application/json" set:html={JSON.stringify(photoMap).replace(/</g,'\\u003c')}/>
    <script src="../scripts/admin.js"></script><script src="../scripts/admin-pwa.js"></script>
  </body>
</html>

