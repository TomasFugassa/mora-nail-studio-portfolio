---
import '@fontsource/bricolage-grotesque/500.css';

import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '../styles/admin.css';
import { getView } from '../lib/view';
const view = await getView();
const photoMap = Object.fromEntries(view.photos.map(p => [p.image, p.thumbnail]));
const sections = [['home','Inicio','home'],['agenda','Agenda','calendar'],['clients','Clientes','users'],['photos','Galería','image'],['services','Servicios','spark'],['hours','Horarios','clock'],['content','Tu página','layout'],['location','Ubicación','pin'],['access','Acceso','lock']];
---
<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="robots" content="noindex,nofollow,noarchive"/><meta name="theme-color" content="#352127"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-title" content="Mi Mora"/>
    <link rel="manifest" href="/admin.webmanifest" crossorigin="use-credentials"/><link rel="apple-touch-icon" href="/pwa/mora-192.png"/><link rel="icon" href="/favicon.svg"/>
    <title>Mi Mora · Tu estudio</title>
  </head>
  <body class="admin-page">
    <a href="#admin-editor" class="admin-skip">Saltar al contenido</a>
    <main id="admin-login" class="login-layout" aria-labelledby="login-title">
      <div class="login-story"><a class="admin-logo" href="/">Mora<span>STUDIO · TU ESPACIO</span></a><div><p class="eyebrow">Menos vueltas · Más tiempo para crear</p><h1>Tu estudio,<br/><em>en tus manos</em></h1><p>Una agenda en orden.<br/>Una colección que crece con vos.</p></div><small>Hecho para el universo Mora.</small></div>
      <div class="login-side"><div class="login-card"><span class="login-badge" aria-hidden="true">M</span><p class="eyebrow">Qué lindo verte por acá</p><h2 id="login-title">Entrá a tu<br/><em>espacio</em></h2><p>Todo lo que necesitás para organizar tu estudio.</p><form id="login-form"><label for="admin-password">Tu contraseña</label><div class="password-wrap"><input id="admin-password" type="password" required autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="128"/><button id="show-password" type="button" aria-label="Mostrar contraseña">Ver</button></div><button type="submit" class="primary">Entrar a mi estudio <span aria-hidden="true">↗</span></button><p id="login-error" role="alert"></p></form><a href="/" class="quiet-link">← Volver a la página de Mora</a><button type="button" class="text-button install-trigger">Instalar Mi Mora ↗</button></div></div>
    </main>
    <div id="admin-workspace" class="app-layout" hidden>
      <aside class="sidebar"><a href="/" class="admin-logo">Mora<span>STUDIO · TU ESPACIO</span></a><p class="nav-caption">TU DÍA, A TU MANERA</p><nav id="admin-tabs" aria-label="Secciones del panel">{sections.map(([id,label,ico])=><button type="button" data-tab={id} data-icon={ico}><span>{label}</span></button>)}</nav><div class="sidebar-bottom"><button class="install-trigger install-card" type="button"><span class="install-symbol" aria-hidden="true">↙</span><span>Siempre a mano<small>Instalá Mi Mora</small></span><span aria-hidden="true">↗</span></button><a href="/" target="_blank" rel="noopener noreferrer" class="sidebar-preview">Ver mi página <span aria-hidden="true">↗</span></a></div></aside>
      <div class="app-main"><header class="app-topbar"><a class="mobile-brand" href="/">Mora<span>MI ESTUDIO</span></a><p id="panel-breadcrumb">Mi Mora <span>/</span> <strong>Inicio</strong></p><div class="topbar-actions"><button class="avatar-button" id="logout" type="button" aria-label="Cerrar sesión">M<span aria-hidden="true">↗</span></button></div></header>
        <main class="workspace-content"><p id="offline-notice" class="admin-demo" role="status" hidden>Sin conexión. Volvé a conectarte para guardar cambios y consultar la agenda actualizada.</p>{view.demo&&<p class="admin-demo"><span><strong>Tu espacio de prueba.</strong> Horarios y duraciones de demostración; todavía no son citas reales.</span></p>}<section id="admin-editor" tabindex="-1" aria-label="Contenido del panel"></section></main>
      </div>
      <nav class="mobile-dock" aria-label="Accesos rápidos"><button type="button" data-route="home" data-icon="home">Inicio</button><button type="button" data-route="agenda" data-icon="calendar">Agenda</button><button type="button" data-route="photos" data-icon="image">Galería</button><button type="button" id="more-nav" data-icon="menu">Más</button></nav>
    </div>
    <dialog id="editor-dialog" class="editor-dialog" aria-labelledby="dialog-heading"><div class="dialog-header"><div><p class="eyebrow" id="dialog-eyebrow">Tu espacio Mora</p><h2 id="dialog-heading"></h2></div><button id="close-editor" type="button" class="icon-button" aria-label="Cerrar ventana">×</button></div><div id="dialog-body"></div></dialog>
    <div id="admin-status" role="status" aria-live="polite" class="toast" hidden></div>
    <script id="admin-photo-map" type="application/json" set:html={JSON.stringify(photoMap).replace(/</g,'\u003c')}/>
    <script src="../scripts/admin.js"></script><script src="../scripts/admin-pwa.js"></script>
  </body>
</html>
