---
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/700.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/mrs-saint-delafield/400.css';
import '../styles/showcase.css';
import '../styles/refinement.css';
import { getView } from '../lib/view';
import Booking from '../components/Booking.astro';
import {Image, getImage} from 'astro:assets';
import atmosphereRoses from '../assets/atmosphere-roses.jpg';
import atmosphereSunlight from '../assets/atmosphere-sunlight.jpg';
const bookingAtmosphere=await getImage({src:atmosphereRoses,width:1400,format:'webp',quality:80});
const {photos,hero,secondary,studio,services,serviceOptions,copy,location:place,faq}=await getView();
const filters = [{id:'all',label:'Todos los diseños'},{id:'sutil',label:'Sutiles'},{id:'color',label:'Con color'},{id:'arte',label:'Nail art'}];
const heroSlides = [hero,...photos.filter(photo=>photo.id!==hero.id)].slice(0,7);
const tones = ['#782f3e','#9b5764','#526376','#586348','#a65967','#29272c','#bd805f'];
const heroCopies=[
  {lines:[copy.heroLine1,copy.heroLine2,copy.heroAccent],description:copy.heroDescription},
  {lines:[copy.hero2Line1,copy.hero2Line2,copy.hero2Accent],description:copy.hero2Description},
  {lines:[copy.hero3Line1,copy.hero3Line2,copy.hero3Accent],description:copy.hero3Description},
];
const copySequence=[0,1,0,2,1,2,0];
const editorial = photos.find(photo=>photo.id==='bloom') || secondary;
const contactPhoto = photos.find(photo=>photo.id==='ink') || hero;
const shortName = studio.name.replace(/\s*(nail\s*)?studio/i,'').trim();
---
<!doctype html>
<html lang="es-UY"><head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Muestra interactiva de una web para un estudio de uñas: colección, servicios, reservas y panel de gestión. Diseño y desarrollo por Tomás Fugassa."/>
  <meta name="robots" content="noindex, nofollow, noarchive"/><meta name="theme-color" content="#f6f1e9"/>
  <title>{studio.name} · Una muestra de Tomás Fugassa</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
</head><body data-showcase-version="mora-3d-1">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header"><a class="wordmark" href="#" aria-label={studio.name+', inicio'}>{shortName.toLowerCase()}<span>NAIL STUDIO</span></a><nav class="desktop-nav" aria-label="Navegación principal"><a href="#coleccion">La colección</a><a href="#servicios">Servicios</a><a href="#estudio">El estudio</a></nav><span class="author-signature" role="img" aria-label="Firma de Tomás F"><span aria-hidden="true">Tomás F</span><svg class="signature-swoosh" viewBox="0 0 160 32" aria-hidden="true"><path d="M5 24C44 14 102 5 143 8c-20 1-47 9-48 14-1 7 28 1 47-6M36 16l-8 12M44 14l-7 12"/></svg></span><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></header>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil" hidden><a href="#coleccion">La colección</a><a href="#servicios">Servicios</a><a href="#estudio">El estudio</a><a href="#reservas">Reservar un turno</a></nav>
  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title" aria-roledescription="carrusel" aria-label="Diseños destacados">
      <div class="hero-copy"><p class="eyebrow">MANICURÍA & NAIL ART</p><h1 id="hero-title" data-copy-index="0"><span>{copy.heroLine1}</span><span>{copy.heroLine2}</span><span class="hero-accent">{copy.heroAccent}</span></h1><p class="hero-description">{copy.heroDescription}</p><a class="button button-dark" href="#reservas">Elegir mi próximo turno</a><div class="hero-selection"><span>EN PORTADA</span><p id="hero-caption">{hero.title}</p><small id="hero-category">{hero.label}</small></div></div>
      <div class="hero-visual" tabindex="0" aria-label="Fotografías destacadas. Usá las flechas para cambiar de diseño"><div class="hero-slide is-current"><img src={hero.large} alt={hero.alt} width="1024" height="1280" loading="eager" fetchpriority="high"/></div><div class="hero-slide" aria-hidden="true"><img alt="" width="1024" height="1280" decoding="async"/></div></div>
      <div class="hero-control-bar"><div class="hero-counter"><span id="hero-position">01</span><span class="counter-line"></span><span>{String(heroSlides.length).padStart(2,'0')}</span></div><div class="hero-previews" aria-label="Elegir un diseño destacado">{heroSlides.map((photo,index)=><button type="button" class:list={['hero-preview',{'is-active':index===0}]} data-slide={index} aria-label={'Mostrar '+photo.title} aria-pressed={index===0}><img src={photo.thumbnail} alt="" width="80" height="96"/><span>{photo.title}</span><i aria-hidden="true"></i></button>)}</div><div class="hero-arrows"><button id="hero-prev" type="button" aria-label="Diseño anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14"/></svg></button><button id="hero-next" type="button" aria-label="Diseño siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7M3 12h14"/></svg></button></div></div>
      <script id="hero-copies" type="application/json" set:html={JSON.stringify(heroCopies).replace(/</g,'\\u003c')}/><script id="hero-slides" type="application/json" set:html={JSON.stringify(heroSlides.map(({id,number,title,alt,large,label},index)=>({id,number,title,alt,src:large,label,tone:tones[index%tones.length],copyIndex:copySequence[index%copySequence.length]}))).replace(/</g,'\\u003c')}/>
    </section>
    <section class="collection" id="coleccion" aria-labelledby="collection-title"><div class="collection-atmosphere" aria-hidden="true"><Image src={atmosphereRoses} width={1400} format="webp" quality={80} loading="lazy" alt=""/></div><div class="section-heading"><div><p class="eyebrow">EL LOOKBOOK</p><h2 id="collection-title">{copy.collectionLine1}<br/><span>{copy.collectionLine2}</span></h2></div><p>Color pleno, brillo suave o un detalle inesperado.<br/>Mirá de cerca y elegí tu referencia.</p></div><div class="collection-controls"><div class="filters" aria-label="Filtrar diseños">{filters.map(filter=><button class:list={['filter',{active:filter.id==='all'}]} type="button" data-filter={filter.id} aria-pressed={filter.id==='all'}>{filter.label}</button>)}</div><p class="collection-count"><span id="photo-count" aria-live="polite">{photos.length}</span> diseños</p></div>
      <div class="gallery-window" tabindex="0" aria-label="Colección de diseños; desplazate horizontalmente para explorar"><div class="gallery">{photos.map(photo=><article class="gallery-item" data-category={photo.category}><button class="photo-button" type="button" data-photo-id={photo.id} data-photo-number={photo.number} data-photo-src={photo.large} data-photo-title={photo.title} data-photo-alt={photo.alt} data-photo-label={photo.label} aria-label={'Ver diseño '+photo.number+': '+photo.title}><img src={photo.large} alt={photo.alt} width="1024" height="1280" loading="lazy" decoding="async"/><span class="photo-open">Ver el detalle <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12m-5-5 5 5-5 5"/></svg></span></button><div class="photo-caption"><span class="photo-index">{photo.number}</span><div><h3>{photo.title}</h3><span>{photo.label}</span></div></div></article>)}</div></div><div class="collection-end"><p>Guardá un diseño como referencia para tu consulta</p><span>EXPLORÁ LA COLECCIÓN <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18m-6-6 6 6-6 6"/></svg></span></div>
    </section>
    <section class="palette-section" id="estudio" aria-labelledby="palette-title"><div class="palette-art" aria-hidden="true"><div class="palette-atmosphere"><Image src={atmosphereSunlight} width={1400} format="webp" quality={80} loading="lazy" alt=""/></div><div class="palette-disc"></div><div id="polish-3d" class="polish-viewer" data-brand={shortName.toLowerCase()} aria-hidden="true"></div><div class="polish-bottle"><div class="polish-cap"></div><div class="polish-neck"></div><div class="polish-glass"><span>{shortName.toLowerCase()}<small>NAIL COLOR</small></span></div></div><span class="palette-color-name">01 — CHERRY</span></div><div class="palette-copy"><p class="eyebrow">EL ESTUDIO</p><h2 id="palette-title">{copy.studioLine1}<br/><span>{copy.studioLine2}</span></h2><p class="studio-lead">{copy.studioLead}</p><p>{studio.intro}</p><div class="palette-swatches" role="group" aria-label="Explorar paletas de color"><button type="button" class="is-selected" data-color="#782f3e" data-color-name="01 — CHERRY" aria-label="Ver paleta cereza" aria-pressed="true"></button><button type="button" data-color="#b97d83" data-color-name="02 — PEARL" aria-label="Ver paleta rosa" aria-pressed="false"></button><button type="button" data-color="#7e9fb9" data-color-name="03 — BLUE" aria-label="Ver paleta azul" aria-pressed="false"></button><button type="button" data-color="#647253" data-color-name="04 — OLIVE" aria-label="Ver paleta oliva" aria-pressed="false"></button><button type="button" data-color="#a65967" data-color-name="05 — BLOOM" aria-label="Ver paleta floral" aria-pressed="false"></button><button type="button" data-color="#29272c" data-color-name="06 — INK" aria-label="Ver paleta negra" aria-pressed="false"></button><button type="button" data-color="#db9b76" data-color-name="07 — APRICOT" aria-label="Ver paleta damasco" aria-pressed="false"></button></div><small>Probá un color</small></div></section>
    <section class="services section" id="servicios" aria-labelledby="services-title"><div class="services-atmosphere" aria-hidden="true"><Image src={atmosphereRoses} width={1000} format="webp" quality={75} loading="lazy" alt=""/></div>
      <div class="services-header"><div><p class="eyebrow">LA CARTA DE SERVICIOS</p><h2 id="services-title">Una técnica<br/>para cada idea</h2></div><div class="service-summary"><p>Desde el acabado más sutil hasta un diseño con todo el detalle. Conocé las técnicas y elegí tu próximo turno.</p><a class="button button-outline" href="#reservas">Ver disponibilidad</a></div></div>
      <div class="service-layout"><div class="service-list">{services.map(service=><details class="service-row"><summary><span class="service-number">{service.number}</span><h3>{service.title}</h3><span class="service-toggle" aria-hidden="true"></span></summary><div class="service-body"><div class="service-tags">{service.tags.map(tag=><span>{tag}</span>)}</div><p>{service.description}</p><a href="#contacto" class="service-inquiry" data-service={service.tags[0]}>Consultar por este servicio</a></div></details>)}</div>
      <div class="service-editorial"><img class="shot-backdrop" src={editorial.large} alt="" aria-hidden="true" width="1024" height="1280" loading="lazy"/><figure class="shot-frame"><img class="shot-photo" src={editorial.large} alt={editorial.alt} width="1024" height="1280" loading="lazy"/><figcaption><span>EN LA COLECCIÓN</span><strong>{editorial.title}</strong></figcaption></figure></div></div>
    </section>
    <Booking backdrop={bookingAtmosphere.src}/>
    <section class="contact section" id="contacto" aria-labelledby="contact-title">
      <div class="contact-photo"><img src={contactPhoto.large} alt={contactPhoto.alt} width="1024" height="1280" loading="lazy"/><div class="contact-photo-caption"><span>LA COLECCIÓN MORA</span><p>{contactPhoto.title}</p></div></div>
      <div class="contact-content"><div class="contact-heading"><p class="eyebrow">CONVERSEMOS</p><h2 id="contact-title">{copy.contactLine1}<br/><span>{copy.contactLine2}</span></h2><p>Un color, un detalle, una ocasión. Contanos lo que tenés en mente y sumá tu diseño de referencia.</p></div>
      <form id="inquiry-form" class="inquiry-form" data-phone={studio.whatsappPhone} data-studio={studio.name}><label for="service">Servicio que te interesa</label><select id="service" name="service"><option value="" selected>Elegí un servicio</option>{serviceOptions.map(option=><option value={option}>{option}</option>)}</select><label for="idea">Tu idea <span>(opcional)</span></label><textarea id="idea" name="idea" rows="3" maxlength="500" placeholder="Un color, un diseño, una ocasión…"></textarea><div class="selected-reference" id="selected-reference" hidden><span>Diseño de referencia</span><strong id="reference-name"></strong><button type="button" id="clear-reference" aria-label="Quitar diseño de referencia">Quitar</button></div><button type="submit" class="button button-dark">Probar consulta</button><p class="form-note">Esta es una demostración: no se envía ninguna consulta.</p><p id="form-status" role="status" class="form-status"></p></form></div>
    </section>
    {place.confirmed&&<section class="location-section section" id="ubicacion" aria-labelledby="location-title"><div><p class="eyebrow">DÓNDE ENCONTRARNOS</p><h2 id="location-title">Nos vemos<br/>en el estudio</h2><p class="location-address">{place.address}</p><a class="text-link" href={'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(place.address)} target="_blank" rel="noopener noreferrer">Cómo llegar</a></div><div class="location-map"><div id="map-placeholder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/></svg><p>{studio.name}</p><button type="button" class="button button-dark" id="load-map" data-map-src={'https://www.google.com/maps?q='+encodeURIComponent(place.address)+'&output=embed'}>Abrir el mapa</button><small>Se conecta con Google Maps al abrirlo.</small></div><iframe id="studio-map" title={'Ubicación de '+studio.name} referrerpolicy="no-referrer" loading="lazy" allowfullscreen hidden></iframe></div></section>}
    <section class="faq section" aria-labelledby="faq-title"><div class="faq-atmosphere" aria-hidden="true"><Image src={atmosphereSunlight} width={1000} format="webp" quality={75} loading="lazy" alt=""/></div><div class="faq-heading"><p class="eyebrow">ANTES DE RESERVAR</p><h2 id="faq-title">Un par de<br/>buenas preguntas</h2></div><div class="faq-list">{faq.map((item,index)=><article><span class="faq-number">{String(index+1).padStart(2,'0')}</span><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>
    </main>
  <footer class="site-footer"><div class="footer-top"><a href="#" class="footer-wordmark" aria-label="Volver al inicio">{shortName.toLowerCase()}</a><div><p>NAIL STUDIO</p><a href="#reservas">Elegí tu próximo turno</a></div></div><div class="footer-bottom"><span>Marca ficticia · Imágenes generadas para esta demo</span><span>Diseño y desarrollo · Tomás Fugassa</span><a href="/admin">Panel del estudio</a></div></footer>
  <dialog id="photo-dialog" class="photo-dialog" aria-labelledby="dialog-title"><div class="dialog-inner"><button class="dialog-close" type="button" aria-label="Cerrar fotografía">Cerrar <span aria-hidden="true">×</span></button><div class="dialog-image-wrap"><img id="dialog-image" alt=""/><button class="dialog-prev" type="button" aria-label="Ver diseño anterior">←</button><button class="dialog-next" type="button" aria-label="Ver diseño siguiente">→</button></div><div class="dialog-caption"><div><p id="dialog-label" class="eyebrow"></p><h2 id="dialog-title"></h2><p class="dialog-position" id="dialog-position" aria-live="polite"></p></div><button id="use-reference" class="button button-dark" type="button">Guardar como referencia</button></div></div></dialog>
  <script src="../scripts/showcase.ts"></script>
</body></html>


