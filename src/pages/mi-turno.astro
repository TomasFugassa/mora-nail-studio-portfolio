---
import '@fontsource/bricolage-grotesque/500.css';import '@fontsource/instrument-sans/400.css';import '../styles/admin.css';
---
<!doctype html><html lang="es-UY"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>Mi turno · Mora Studio</title></head><body><header class="admin-header"><a href="/" class="admin-logo">Mora<span>STUDIO</span></a><a href="/">Volver al estudio ↗</a></header><main class="admin-shell"><section class="login-card"><p class="eyebrow">Tu enlace privado</p><h1>Tu momento<br/><em>Mora</em></h1><p id="turno-detail" role="status">Buscando tu turno…</p><button id="cancel-turno" hidden>Cancelar este turno</button><p id="turno-status" role="status"></p></section></main><script>const token=new URLSearchParams(location.hash.slice(1)).get('token'),detail=document.getElementById('turno-detail')!,button=document.getElementById('cancel-turno') as HTMLButtonElement,status=document.getElementById('turno-status')!;async function act(action:string){try{const res=await fetch('/api/booking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,token})}),data=await res.json();if(!res.ok)throw Error(data.error);detail.textContent=`${data.service} · ${new Intl.DateTimeFormat('es-UY',{dateStyle:'full',timeStyle:'short',timeZone:'America/Montevideo'}).format(data.start)} · ${data.status==='confirmed'?'Confirmado':data.status==='cancelled'?'Cancelado':'Realizado'}`;button.hidden=data.status!=='confirmed'||data.start<=Date.now();if(action==='cancel')status.textContent='Turno cancelado; el horario vuelve a estar disponible.';}catch(error){detail.textContent=error instanceof Error?error.message:'No pudimos encontrar el turno.';}}button.addEventListener('click',async()=>{if(confirm('¿Querés cancelar este turno?')){button.disabled=true;await act('cancel');button.disabled=false;}});void act('lookup');</script></body></html>
